# Judge.me (Settings > Integrations > View API tokens)
JUDGEME_API_TOKEN=
JUDGEME_SHOP_DOMAIN=

# OpenRouter (openrouter.ai/keys) - ucretsiz modeller icin kart gerekmez;
# anahtara dusuk bir harcama limiti (ornegin 1 dolar) koyun
OPENROUTER_API_KEY=

# Shopify Admin API (Client Credentials Grant - dev.shopify.com/dashboard,
# uygulama > Settings > Client ID / Client secret). Uygulama önce mağazaya
# kurulu olmalı (shopify app dev ile zaten kuruldu).
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Slack app (api.slack.com/apps)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_APP_TOKEN=
